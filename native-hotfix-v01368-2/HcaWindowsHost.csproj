<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>HCA_Produktionsmanager</AssemblyName>
    <RootNamespace>HcaWindowsHost</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ApplicationIcon>Assets\HCA.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>HCA Produktionsmanager</AssemblyTitle>
    <Company>Werbestudio Königswinter</Company>
    <Product>HCA Produktionsmanager</Product>
    <Version>0.13.68.2</Version>
    <FileVersion>0.13.68.2</FileVersion>
    <InformationalVersion>0.13.68.2-launcher-hotfix</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="All" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\HCA.ico" />
    <None Include="native-bridge.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
